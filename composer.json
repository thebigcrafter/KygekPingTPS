{
    "name": "thebigcrafter/kygek-ping-tps",
    "description": "PocketMine-MP plugin for checking server TPS and player ping",
    "license": "GPL-3.0-only",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/AxolotlBucketLabs/await-generator",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/thebigcrafter/Hydrogen",
            "no-api": true
        }
    ],
    "require": {
        "sof3/await-generator": "dev-devtools-shading-compat as 3.6.1",
        "thebigcrafter/hydrogen": "^1.1.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.17",
        "phpstan/phpstan": "^2.1",
        "axolotl-pm/pocketmine-mp": "5.51.1"
    },
    "autoload-dev": {
        "psr-4": {
            "thebigcrafter\\Hydrogen\\": "tools/stubs/Hydrogen/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse -c phpstan.neon.dist"
    }
}
